// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Vehicle {
  id              String   @id @default(cuid())
  name            String
  type            String   // "motorcycle" | "car" | "minibus"
  licensePlate    String
  pricePerDay     Int?
  status          String   @default("available") // "available" | "rented" | "service"
  imageUrl        String?
  category        String   // e.g. "MPV", "Matic"
  description     String?
  rentalDuration  String?
  maxSpeed        Int?
  seatCapacity    Int?
  selfDrive       Boolean? @default(true)
  hasPhoneCharger Boolean?
  withFuel        Boolean? @default(false)
  features        String?  // Disimpan sebagai text JSON/Koma karena SQLite tidak support array string
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  bookings        VehicleBooking[]
  packages        RentalPackage[]
}

model RentalPackage {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  duration   String   // "full_day" | "half_day"
  driverType String   // "self_drive" | "with_driver"
  fuelOption String   // "with_fuel" | "without_fuel"
  price      Int
}

model VehicleBooking {
  id              String    @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  packageId       String?   // RentalPackage id (optional, for cars with packages)
  basePrice       Int?      // Package base price at time of booking
  finalPrice      Int?      // Negotiated / final deal price
  customer        String
  phone           String
  bookingDate     String
  time            String
  duration        String
  notes           String?
  status          String    @default("BOOKED") // "BOOKED" | "CANCELLED"
  bookingDateTime DateTime?
  releaseDateTime DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model TourPackage {
  id              String   @id @default(cuid())
  title           String
  titleEn         String?
  description     String
  descriptionEn   String?
  imageUrl        String?
  estimatedPrice  Int
  duration        String
  minPax          Int
  maxPax          Int
  startTime       String
  endTime         String
  includes        String?  // JSON string array
  excludes        String?  // JSON string array
  vehicleOptions  String?  // JSON string array of objects
  itinerary       String?  // JSON string array of objects
  category        String?
  priceType       String?  // "per_car" | "per_person"
  destinationTags String?  // JSON string array
  status          String?  @default("draft") // "active" | "draft"
  recommendation  String?  // "New" | "Best Seller" | "Recommended" | "None"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  bookings        TourBooking[]
}

model TourBooking {
  id              String       @id @default(cuid())
  tourPackageId   String
  tourPackage     TourPackage  @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)
  customerName    String
  phone           String
  bookingDate     String
  time            String
  vehicleType     String
  pax             Int
  totalPrice      Int
  status          String       @default("active") // "active" | "completed" | "cancelled"
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Tourist {
  id            String   @id @default(cuid())
  nationality   String
  continent     String   // "Asia" | "Europe" | "Americas"
  packageTaken  String
  photoUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model GoogleReview {
  id         String   @id @default(cuid())
  name       String
  country    String
  rating     Int
  comment    String
  avatarPath String?  // Foto profil / avatar pelanggan
  mediaType  String?  // "image" | "video"
  mediaPath  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String   // "booking" | "complaint" | "information"
  message   String
  status    String   @default("unread") // "unread" | "read" | "replied"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  password         String
  phone            String?
  role             String   @default("user")
  resetToken       String?  @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  notifications    Notification[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PromoBroadcast {
  id              String   @id @default(cuid())
  subject         String
  body            String
  recipientCount  Int
  status          String   @default("sent")
  createdAt       DateTime @default(now())
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
